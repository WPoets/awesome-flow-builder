{
  "name": "wpoets/excel-handler",
  "license": "GPL-3.0-or-later",
  "type": "awesome-handler",
  "description": "Add support for creating and working with excel file within awesome enterprise",
  "keywords": [
    "WordPress",
    "Low Code",
    " Awesome Enterprise",
    "Shortcode",
    "PHP excel"
  ],
  "homepage": "https://getawesomestudio.com/",
  "authors": [
    {
      "name": "WPoets Team",
      "homepage": "https://www.wpoets.com"
    }
  ],
  "support": {
    "docs": "https://www.getawesomestudio.com/enterprise-tutorial/"
  },
    "require": {
        "php": ">=8.1",
        "composer/installers": "~1.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "phpoffice/phpspreadsheet": "^2.1 || ^3.0 || ^5.0"
    },
  "extra": {
    "installer-name": "excel"
  },
  "config": {
    "process-timeout": 600,
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "oomphinc/composer-installers-extender": true
    }
  },
  "prefer-stable": true,
  "require-dev": {}
}
